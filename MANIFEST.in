# The sdist carries a runnable test suite: the tests need their fixtures and
# the demo project, and a half-shipped suite fails for downstream packagers.
include LICENSE README.md README.zh-CN.md CITATION.cff
include CHANGELOG.md CONTRIBUTING.md SECURITY.md
include .github/workflows/ci.yml
include .github/workflows/publish.yml
recursive-include tests *.py
recursive-include examples *
recursive-include skills *.md
recursive-include docs *.md
prune assets
